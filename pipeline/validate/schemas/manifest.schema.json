{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://quchebi.local/schemas/manifest.schema.json",
 "title": "Quchebi pack manifest.json (docs/pack-format.md)",
 "type": "object",
 "required": ["v", "version", "built", "files", "counts", "attribution"],
 "additionalProperties": false,
 "properties": {
  "v": {"const": 1},
  "version": {"type": "string", "pattern": "^[0-9]{8}-[1-9][0-9]*$"},
  "built": {"type": "string", "pattern": "^[0-3][0-9]/[01][0-9]/[0-9]{4}$"},
  "osm": {"type": "string", "minLength": 1},
  "files": {
   "type": "object",
   "required": ["core.json", "geom.json", "houses.json", "areas.json", "eponyms.json"],
   "additionalProperties": {"$ref": "#/$defs/file"}
  },
  "tiles": {
   "type": "object",
   "required": ["files", "bytes"],
   "properties": {
    "basemap": {"type": "string", "pattern": "^tiles/"},
    "glyphs": {"type": "string", "pattern": "^tiles/"},
    "sprites": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^tiles/"}},
    "minzoom": {"type": "integer", "minimum": 0},
    "maxzoom": {"type": "integer", "minimum": 0},
    "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "center": {"type": "array", "items": {"type": "number"}},
    "bytes": {"type": "integer", "minimum": 0},
    "files": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {"pattern": "^tiles/"},
     "additionalProperties": {"$ref": "#/$defs/file"}
    }
   }
  },
  "counts": {
   "type": "object",
   "required": ["features", "streets", "houses", "crossings", "eponyms"],
   "additionalProperties": {"type": "integer", "minimum": 0}
  },
  "attribution": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
 },
 "$defs": {
  "file": {
   "type": "object",
   "required": ["bytes", "sha256"],
   "properties": {
    "bytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
   }
  }
 }
}
