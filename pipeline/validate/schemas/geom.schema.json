{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://quchebi.local/schemas/geom.schema.json",
 "title": "Quchebi pack geom.json: encoded polylines per feature, index-aligned with core.f",
 "type": "object",
 "required": ["v", "prec", "g"],
 "additionalProperties": false,
 "properties": {
  "v": {"const": 1},
  "prec": {"const": 5},
  "g": {
   "type": "array",
   "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
  }
 }
}
