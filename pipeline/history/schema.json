{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quchebi.local/schemas/history-extractor.json",
  "title": "history-extractor result file (data/enrich/results/history/hNNN.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch", "results"],
  "properties": {
    "batch": {"type": "string", "pattern": "^h[0-9]{3}$"},
    "results": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "year": {"type": "integer", "minimum": 1500, "maximum": 2030},
    "name_ka": {"type": "string", "minLength": 2, "maxLength": 120, "pattern": "[ა-ჰ]"},
    "name_ru": {"type": "string", "minLength": 2, "maxLength": 120, "pattern": "[А-Яа-яЁё]"},
    "former_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_ka"],
      "properties": {
        "name_ka": {"$ref": "#/$defs/name_ka"},
        "name_ru": {"$ref": "#/$defs/name_ru"},
        "from_year": {"$ref": "#/$defs/year"},
        "to_year": {"$ref": "#/$defs/year"},
        "named_after": {"type": "string", "minLength": 2, "maxLength": 120}
      }
    },
    "named_after": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_ka"],
      "properties": {
        "name_ka": {"$ref": "#/$defs/name_ka"},
        "name_ru": {"$ref": "#/$defs/name_ru"},
        "note_ru": {"type": "string", "maxLength": 200}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "former_names", "named_after", "confidence", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 3, "maxLength": 300},
        "former_names": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/former_name"}},
        "named_after": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/named_after"}]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
      }
    }
  }
}
